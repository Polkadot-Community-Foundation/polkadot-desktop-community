# Copy to `.env.local` and fill in what you need. Everything is optional unless noted —
# features whose variables are empty stay disabled. See docs/PUBLISHING.md for the full
# build / sign / publish guide.
#
# The file is loaded from the repository root (`envDir` in the vite configs), not from
# `src/`. A `.env.local` under `src/` is dead config.

# ───────────────────────────── Firebase Remote Config ─────────────────────────────
# Public client identifiers (the apiKey is NOT a secret); only API_KEY / PROJECT_ID /
# APP_ID are read by the app. The rest are kept for future Firebase services.
# Remote Config serves the `chains_v2` network catalog — WITHOUT IT THE APP HAS NO
# CHAIN CATALOG AND BOOTSTRAP FAILS.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=<NAME>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<NAME>
VITE_FIREBASE_STORAGE_BUCKET=<NAME>.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ───────────────────────────── Environment catalog ────────────────────────────────
# JSON describing every environment-specific value the app needs that Remote Config
# does NOT serve. Channels inherit the `shared` block; each channel key (e.g. `alpha`)
# is the id, `name` is the display label in the picker; `roles` reference `chains_v2`
# entry ids; `default` must be a channel key. Values below are placeholders — replace
# with your real channels.
VITE_ENVIRONMENTS={"default":"alpha","shared":{"botNetwork":"example-net","hostChatNetwork":"example-net","iosBundleId":"com.example.app","digitalDollarAsset":{"assetId":1,"symbol":"tUSD","precision":6,"palletName":"Assets"}},"channels":{"alpha":{"name":"Alpha Testnet","roles":{"people":"alpha-people","bulletin":"alpha-bulletin","assetHub":"alpha-asset-hub"}},"beta":{"name":"Beta Testnet","roles":{"people":"beta-people","bulletin":"beta-bulletin","assetHub":"beta-asset-hub"}}}}

# ───────────────────────────── Device-sync TURN relay ─────────────────────────────
# WebRTC TURN credentials used by device-sync and A/V calls (optional; the STUN-only
# fallback works on most NATs). This is the HOST's own relay — distinct from
# SANDBOX_RELAY_ALLOWLIST below, which governs what sandboxed products may dial.
VITE_WEBRTC_TURN_HOST=
VITE_WEBRTC_TURN_SECRET=
VITE_WEBRTC_TURN_TTL=

# ───────────────────────────── Product sandbox allowlists ─────────────────────────
# Comma-separated hostnames that sandboxed product webviews may reach WITHOUT the
# per-product permission prompt. Matching is exact host or any subdomain
# (`ipfs.example.com` also matches `cdn.ipfs.example.com`).
#
# Empty / unset is FAIL-CLOSED: no host is silently allowed and every request goes
# through the user-facing permission flow. That is the safe default for a fork
# without dedicated gateway or relay infrastructure — set these only for hosts you
# operate and are willing to expose to every product.
#
# IPFS gateways; GET only, other methods always prompt.
SANDBOX_IPFS_ALLOWLIST=
# TURN/STUN relays products may dial; method-agnostic.
SANDBOX_RELAY_ALLOWLIST=

# ───────────────────────────── Error reporting ────────────────────────────────────
# Sentry DSN baked into the build. Empty = crash reporting disabled.
SENTRY_DSN=
# Sourcemap upload during the build; skipped unless SENTRY_AUTH_TOKEN is set.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ───────────────────────────── Application identity ───────────────────────────────
# Which of the two identities below a build takes: `production` uses the base
# variables, anything else prefers the _DEVELOP ones. Must be identical for the build
# and the packaging step, or the bundles disagree about which app they are.
BUILD_TYPE=
# The identity a packaged build ships under. There is no default and packaging fails
# without all three: an operating system matches an update against the bundle id, so a
# guessed one would install beside the application it was meant to replace — silently.
# APP_NAME is what Electron derives the user-data directory from; changing it moves an
# install to a fresh profile. Unpackaged builds (`npm start`, e2e, fork pull requests)
# run without them.
APP_ID=
PRODUCT_NAME=
APP_NAME=
# Optional. Set them to make develop a separate application with its own install slot,
# profile and signing identity; leave them empty to ship one identity for every build
# type, which is what a deployment with existing installs wants.
APP_ID_DEVELOP=
PRODUCT_NAME_DEVELOP=
APP_NAME_DEVELOP=
# Who the build is copyrighted to, and the maintainer in the Linux package metadata.
# Optional — falls back to the `author` in package.json, and unlike the three above it
# does not fail packaging when unset: a wrong copyright line breaks nothing. No
# _DEVELOP variant, because authorship does not differ between build types.
APP_AUTHOR=

# ───────────────────────────── Auto-update ────────────────────────────────────────
# The release pipeline's explicit opt-in — the in-app updater stays off unless this
# is exactly `true`, so local, PR and e2e builds honestly report that they cannot
# self-update.
ENABLE_AUTO_UPDATE=
# GitHub repository the updater reads releases from, and the one electron-builder
# generates update metadata for. Both default to paritytech/polkadot-desktop-community
# (config/index.js); set them only to point a build at a different repository, e.g. to
# rehearse a release somewhere else.
UPDATE_REPO_OWNER=
UPDATE_REPO_NAME=
# Base URL of a static update feed, without the channel suffix the runtime appends
# (`stable/` or `latest/`). Set it only for a deployment whose installed clients read
# object storage instead of GitHub Releases — it wins over UPDATE_REPO_* above, because a
# build that has to reach an existing feed cannot fall back to a repository its users never
# installed from. The release pipeline mirrors to the same feed when UPDATE_S3_BUCKET is set.
AUTO_UPDATE_URL=

# ───────────────────────────── Build / dev toggles ────────────────────────────────
# Verbose logger output in main / preload / renderer. Any non-empty value enables it.
LOGGER=
# Where the Electron main process loads the renderer from: `localhost` (dev server)
# or `filesystem` (built assets). The build scripts set this for you; override only
# for unusual local setups.
RENDERER_SOURCE=
# Override Electron's userData directory (used by e2e to isolate test profiles).
ELECTRON_USER_DATA=

# ───────────────────────────── E2E tests ──────────────────────────────────────────
# Base URL and API token of the signing-bot service. Required by the auth /
# authenticated / chat / product-sdk projects; smoke, security and link-navigation
# run without them. An empty BOT_URL makes the bot-backed projects fail fast rather
# than silently dial nothing.
BOT_URL=https://signing-bot.example.com
BOT_TOKEN=
# Pin a bot identity instead of generating a per-run one (optional).
BOT_USERNAME=
# Pre-attested {alice, bob} pairs for the two-client chat tests (default 6).
CHAT_PAIR_POOL_SIZE=
# Serve the link-navigation fixtures from an external URL instead of the local server.
LINK_TESTS_URL=
# Override the permanent chat peer identity used by the single-client chat tests
# (default: `desktoptest-chatpeer`, on the `botNetwork` from VITE_ENVIRONMENTS).
CHAT_PEER_BOT_USERNAME=
CHAT_PEER_BOT_LITE_USERNAME=
CHAT_PEER_BOT_NETWORK=
# Playwright worker count; overrides the per-project default.
E2E_WORKERS=
